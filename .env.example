# Copia este archivo como .env.local y completa los valores reales.
# .env.local está ignorado por git: nunca subas claves al repositorio.

VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Endpoint de reconocimiento de placas entregado por el docente.
# Incluye el parámetro ?code=... , por eso jamás debe escribirse en el código
# fuente ni publicarse en GitHub. En producción se inyecta como secreto.
VITE_OCR_ENDPOINT=
